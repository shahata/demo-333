{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the task is completed"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "created_only_by_backend_function"
      }
    },
    "update": {
      "user_condition": {
        "role": "updated_only_by_backend_function"
      }
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}